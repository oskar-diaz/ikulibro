!!!
%html{lang: "es"}
  %head
    - page_title = content_for?(:title) ? yield(:title) : "Afinando un sueño — El ikulibro de Oskar Díaz Toscano"
    - page_description = content_for?(:meta_description) ? yield(:meta_description) : "Afinando un sueño (el ikulibro): reedición revisada y ampliada del libro de Oskar Díaz Toscano. Disponible en Amazon. Japón, ikusuki e ikulibro en un mismo viaje literario."
    - canonical_url = content_for?(:canonical) ? yield(:canonical) : "#{request.base_url}#{request.path}"
    - og_image = content_for?(:og_image) ? yield(:og_image) : asset_url("big_cover.jpg")
    - og_type = content_for?(:og_type) ? yield(:og_type) : "book"
    - book_url = root_url
    - breadcrumbs = [{ name: "Inicio", url: root_url }]
    - breadcrumbs << { name: "Reseñas", url: reviews_url } if request.path == reviews_path
    - breadcrumb_items = breadcrumbs.each_with_index.map { |crumb, index| { "@type" => "ListItem", "position" => index + 1, "name" => crumb[:name], "item" => crumb[:url] } }
    - faq_items = (controller_name == "welcome" && action_name == "index") ? [{ question: "¿Qué es el ikulibro?", answer: "El ikulibro es la obra Afinando un sueño, una colección de historias sobre Japón y el viaje personal de Oskar Díaz Toscano." }, { question: "¿Dónde puedo comprar Afinando un sueño?", answer: "Está disponible en Amazon en varias tiendas internacionales. Puedes elegir tu país en la sección Disponible en." }, { question: "¿Hay una versión gratuita en PDF?", answer: "Sí. Puedes descargar gratis la primera edición (de hace 13 años). No es la versión actual que se vende en Amazon, que es la reedición revisada y ampliada con más de 200 páginas de contenido adicional." }] : []
    - faq_entities = faq_items.map { |item| { "@type" => "Question", "name" => item[:question], "acceptedAnswer" => { "@type" => "Answer", "text" => item[:answer] } } }
    - schema_graph = []
    - schema_graph << { "@type" => "WebSite", "name" => "Ikulibro", "url" => canonical_url, "inLanguage" => "es" }
    - schema_graph << { "@type" => "Organization", "name" => "Ikulibro", "url" => root_url, "logo" => asset_url("book.png"), "sameAs" => ["http://www.ikublog.com", "http://instagram.com/ikusuki", "https://www.youtube.com/ikusuki", "https://www.tiktok.com/@ikusukinews", "https://open.spotify.com/show/7jAFNnKIQTgVttc1ZCmkl2", "https://podcasts.apple.com/us/podcast/afinando-un-sue%C3%B1o-lectura-del-ikulibro/id1596236167"] }
    - schema_graph << { "@type" => "Book", "name" => "Afinando un sueño", "author" => { "@type" => "Person", "name" => "Oskar Díaz Toscano" }, "description" => "Reedición revisada y ampliada del ikulibro Afinando un sueño.", "inLanguage" => "es", "image" => og_image, "url" => book_url, "publisher" => { "@type" => "Organization", "name" => "Ikulibro" } }
    - schema_graph << { "@type" => "BreadcrumbList", "itemListElement" => breadcrumb_items }
    - schema_graph << { "@type" => "FAQPage", "mainEntity" => faq_entities } if faq_entities.any?
    - schema = { "@context" => "https://schema.org", "@graph" => schema_graph }
    %meta{charset: "utf-8"}/
    %meta{content: "width=device-width, initial-scale=1.0", name: "viewport"}/
    %title= page_title
    %meta{name: "description", content: page_description}/
    %meta{name: "keywords", content: "ikulibro, ikusuki, Japón, Afinando un sueño, Oskar Díaz Toscano, libro, Amazon, reedición"}/
    %meta{name: "author", content: "Oskar Díaz Toscano"}/
    %meta{name: "robots", content: "index, follow"}/
    %meta{name: "theme-color", content: "#f3d31a"}/
    %link{rel: "canonical", href: canonical_url}/
    %link{rel: "alternate", hreflang: "es", href: canonical_url}/
    %link{rel: "alternate", hreflang: "es-ES", href: canonical_url}/
    %link{rel: "alternate", hreflang: "x-default", href: canonical_url}/
    %link{rel: "icon", href: "/favicon.ico"}/
    %link{rel: "apple-touch-icon", href: asset_path("book.png")}/
    %link{rel: "preconnect", href: "https://fonts.googleapis.com"}/
    %link{rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: true}/
    %meta{property: "og:site_name", content: "Ikulibro"}/
    %meta{property: "og:title", content: page_title}/
    %meta{property: "og:description", content: page_description}/
    %meta{property: "og:type", content: og_type}/
    %meta{property: "og:url", content: canonical_url}/
    %meta{property: "og:image", content: og_image}/
    %meta{property: "og:image:alt", content: "Portada de Afinando un sueño"}/
    %meta{property: "og:locale", content: "es_ES"}/
    %meta{property: "book:author", content: "Oskar Díaz Toscano"}/
    %meta{name: "twitter:card", content: "summary_large_image"}/
    %meta{name: "twitter:title", content: page_title}/
    %meta{name: "twitter:description", content: page_description}/
    %meta{name: "twitter:image", content: og_image}/
    %script{type: "application/ld+json"}= raw(schema.to_json)
    = stylesheet_link_tag  "application"
    %link{href: "https://fonts.googleapis.com/css?family=Neucha", rel: "stylesheet", type: "text/css"}/
    %link{href: "https://fonts.googleapis.com/css2?family=Farsan&display=swap", rel: "stylesheet", type: "text/css"}/
