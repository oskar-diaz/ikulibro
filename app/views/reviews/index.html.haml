- content_for :title do
  Reseñas — Afinando un sueño
- content_for :meta_description do
  Reseñas de lectores sobre Afinando un sueño (ikulibro) y su reedición. Opiniones de la primera edición y de Amazon.
- content_for :canonical do
  = reviews_url
- content_for :og_type do
  website

#reviews.bounceInUp.animated
  - active_tab = @active_tab.presence || "crowdfunding"
  %h2 Reseñas
  .reviews-tabs
    %a.tab-link{href: "#", class: ("active" if active_tab == "crowdfunding"), data: { tab: "crowdfunding" }}
      Primera edición (crowdfunding)
      %span.badge= @reviews_crowdfunding.size
    %a.tab-link{href: "#", class: ("active" if active_tab == "amazon"), data: { tab: "amazon" }}
      Segunda edición (amazon)
      %span.badge= @reviews_amazon.size
  .reviews-panel{data: { tab: "crowdfunding" }, style: ("display: block;" if active_tab == "crowdfunding")}
    - if @reviews_crowdfunding.any?
      -@reviews_crowdfunding.each_with_index do |review,idx|
        - review_dom_id = "crowdfunding-review-#{idx + 1}"
        - review_link = reviews_path(tab: "crowdfunding", anchor: review_dom_id)
        - review_share_link = reviews_url(tab: "crowdfunding", anchor: review_dom_id)
        .review{id: review_dom_id, :class => (idx % 2 ==0 ? "a" : "b")}
          .review-header
            %p.name
              %a.review-link{href: review_link}= review.name
            %button.review-share{type: "button", data: { share_url: review_share_link, copied_label: "Enlace copiado", default_label: "Compartir" }, aria: { label: "Copiar enlace de esta reseña" }}
              Compartir
          .text
            = simple_format review.review
          - if review.images
            - review.images.each do |img|
              = image_tag  img.url
          - date_text = human_review_date(review.created_at)
          - if date_text
            %p.review-date= date_text
          .n="#{idx+1}"
        - unless idx + 1 == @reviews_crowdfunding.size

          %hr
    - else
      %p.no-reviews
        Esperando impacientemente a que alguien se lo lea...
        = image_tag "tumbleweed.gif", alt: ""
  .reviews-panel{data: { tab: "amazon" }, style: ("display: block;" if active_tab == "amazon")}
    - if @reviews_amazon.any?
      -@reviews_amazon.each_with_index do |review,idx|
        - review_dom_id = "amazon-review-#{idx + 1}"
        - review_link = reviews_path(tab: "amazon", anchor: review_dom_id)
        - review_share_link = reviews_url(tab: "amazon", anchor: review_dom_id)
        .review{id: review_dom_id, :class => (idx % 2 ==0 ? "a" : "b")}
          .review-header
            %p.name
              %a.review-link{href: review_link}= review.name
            %button.review-share{type: "button", data: { share_url: review_share_link, copied_label: "Enlace copiado", default_label: "Compartir" }, aria: { label: "Copiar enlace de esta reseña" }}
              Compartir
          .text
            = simple_format review.review
          - if review.images
            - review.images.each do |img|
              = image_tag  img.url
          - date_text = human_review_date(review.created_at)
          - if date_text
            %p.review-date= date_text
          .n="#{idx+1}"
        - unless idx + 1 == @reviews_amazon.size

          %hr
    - else
      %p.no-reviews
        Esperando impacientemente a que alguien se lo lea...
        = image_tag "tumbleweed.gif", alt: ""
